+                Special_InverseCore_Small<T>
+                    <<<dim3(1, 1, batch_size), dim3(threads), shared,
+                       cfg.stream>>>(device_inout, root_of_unity_table,
+                                     cfg.n_power, cfg.mod_inverse);
+            }
+            else
+            {
+                Special_ForwardCore_Small<T>
+                    <<<dim3(1, 1, batch_size), dim3(threads), shared,
+                       cfg.stream>>>(device_inout, root_of_unity_table,
+                                     cfg.n_power);
+            }
+            GPUFFT_CUDA_CHECK(cudaGetLastError());
+            return;
+        }
