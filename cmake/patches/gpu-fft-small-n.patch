+    // Single-block IFFT for n_power in [1, 10]. Loads the full FFT into
+    // shared memory, runs all log2(N) Gentleman-Sande stages in-place,
+    // multiplies by n_inverse on writeback. Each thread handles one
+    // butterfly per stage (blockDim.x = N/2). Reuses the same ordered-root
+    // layout (root_idx = m + (idx & (m-1))) as Special_InverseCore so it
+    // shares the existing root table.
+    template <typename T>
+    __global__ void
+    Special_InverseCore_Small(COMPLEX<T>* polynomial,
+                              COMPLEX<T>* root_of_unity_table, int N_power,
+                              COMPLEX<T> n_inverse)
+    {
+        extern __shared__ char shared_memory_typed[];
+        COMPLEX<T>* shared_memory =
+            reinterpret_cast<COMPLEX<T>*>(shared_memory_typed);
+
+        const int idx = threadIdx.x;
+        const int N = 1 << N_power;
+        const int half = N >> 1;
+        const location_t batch_offset =
+            (location_t) blockIdx.z << N_power;
+
+        shared_memory[idx] = polynomial[batch_offset + idx];
+        shared_memory[idx + half] = polynomial[batch_offset + idx + half];
+        __syncthreads();
+
+        int m = half;     // distinct-roots count for this stage
+        int t = half;     // butterfly stride
+        int t_log = N_power - 1; // log2(t)
+        for (int s = 0; s < N_power; s++)
+        {
+            const int pair_base = ((idx >> t_log) << t_log) + idx;
+            const int root_idx = m + (idx & (m - 1));
+            GentlemanSandeUnit<T>(shared_memory[pair_base],
+                                  shared_memory[pair_base + t],
+                                  root_of_unity_table[root_idx]);
+            m >>= 1;
+            t >>= 1;
+            t_log -= 1;
+            __syncthreads();
+        }
+
+        polynomial[batch_offset + idx] = shared_memory[idx] * n_inverse;
+        polynomial[batch_offset + idx + half] =
+            shared_memory[idx + half] * n_inverse;
+    }
+
+    // Single-block forward FFT for n_power in [1, 10]. Mirrors
+    // Special_ForwardCore but does all stages in one launch since N <= 1024
+    // fits in shared memory.
+    template <typename T>
+    __global__ void Special_ForwardCore_Small(
+        COMPLEX<T>* polynomial, COMPLEX<T>* inverse_root_of_unity_table,
+        int N_power)
+    {
+        extern __shared__ char shared_memory_typed[];
+        COMPLEX<T>* shared_memory =
+            reinterpret_cast<COMPLEX<T>*>(shared_memory_typed);
+
+        const int idx = threadIdx.x;
+        const int N = 1 << N_power;
+        const int half = N >> 1;
+        const location_t batch_offset =
+            (location_t) blockIdx.z << N_power;
+
+        shared_memory[idx] = polynomial[batch_offset + idx];
+        shared_memory[idx + half] = polynomial[batch_offset + idx + half];
+        __syncthreads();
+
+        // Cooley-Tukey: m doubles each stage, t doubles each stage.
+        int m = 1;
+        int t = 1;
+        int t_log = 0;
+        for (int s = 0; s < N_power; s++)
+        {
+            const int pair_base = ((idx >> t_log) << t_log) + idx;
+            const int root_idx = m + (idx & (m - 1));
+            CooleyTukeyUnit<T>(shared_memory[pair_base],
+                               shared_memory[pair_base + t],
+                               inverse_root_of_unity_table[root_idx]);
+            m <<= 1;
+            t <<= 1;
+            t_log += 1;
+            __syncthreads();
+        }
+
+        polynomial[batch_offset + idx] = shared_memory[idx];
+        polynomial[batch_offset + idx + half] = shared_memory[idx + half];
+    }
