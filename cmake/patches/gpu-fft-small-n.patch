+        // Single-block path for n_power in [1, 10]. Avoids the multi-launch
+        // chain entirely; existing big-N kernel and its kernel-table
+        // dispatch are unchanged below.
+        if (cfg.n_power <= 10)
+        {
+            const int N = 1 << cfg.n_power;
+            const int threads = N >> 1; // >= 1 (n_power >= 1)
+            const size_t shared = N * sizeof(COMPLEX<T>);
+            if (cfg.fft_type == INVERSE)
